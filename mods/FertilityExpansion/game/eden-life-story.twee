:: Eden Life Story Arrival
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">><<effects>>
<<set $eden.lifeStoryReadMode to "first">>
<div class="eden-panel">
	<<set _edenChildId to $eden.selectedChildId>>
	<<set _edenRecord to _edenChildId ? $eden.children[_edenChildId] : undefined>>
	<<set _edenChild to ($children and _edenChildId) ? $children[_edenChildId] : undefined>>
	<<if !_edenRecord or !_edenChild>>
		<p class="red">无法找到这封来信对应的孩子。</p>
		<<link [[返回伊甸园|Eden Home]]>><</link>>
	<<else>>
		<<run window.EdenLifeStory.markDiscovered(_edenRecord)>>
		<p>这是<<= Util.escapeMarkup(_edenChild.name || "这个孩子")>>寄来的，里面是长长的一封信，还附带着几张照片。</p>
		<p>你展开信件，你的孩子将<<= _edenChild.gender is "m" ? "他" : "她">>的近况告诉了你。</p>
		<br>
		<<if window.EdenLifeStory.canRead(_edenRecord)>>
			<<link [[阅读来信|Eden Life Story Read]]>><</link>>
		<<else>>
			<<link [[展开信纸|Eden Life Story Generate]]>><</link>>
		<</if>>
	<</if>>
</div>

:: Eden Life Story Generate
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">><<effects>>
<<set $eden.lifeStoryReadMode to "first">>
<div class="eden-panel">
	<<set _edenChildId to $eden.selectedChildId>>
	<<set _edenRecord to _edenChildId ? $eden.children[_edenChildId] : undefined>>
	<<set _edenChild to ($children and _edenChildId) ? $children[_edenChildId] : undefined>>
	<<set _edenLifeStory to _edenRecord ? window.EdenLifeStory.ensureState(_edenRecord) : null>>
	<<if !_edenRecord or !_edenChild or !_edenLifeStory>>
		<p class="red">无法读取这封来信。</p>
		<<link [[返回通讯录|Eden Contacts]]>><</link>>
	<<elseif _edenLifeStory.content>>
		<<goto "Eden Life Story Read">>
	<<elseif _edenLifeStory.status is "error">>
		<p class="red">来信内容生成失败：<<= Util.escapeMarkup(_edenLifeStory.error || "未知错误")>></p>
		<p>不会因为这次失败丢失来信，修正接口设置后可以再次尝试。</p>
		<<button "重试生成">>
			<<run window.EdenLifeStory.resetForRetry($eden.children[$eden.selectedChildId])>>
			<<goto "Eden Life Story Generate">>
		<</button>>
		<br><br>
		<<link [[稍后再读|Eden Contacts]]>><</link>>
	<<else>>
		<p>你拆开信封，小心翼翼地打开信纸……</p>
		<div class="eden-letter-loading" role="img" aria-label="信封打开，信纸缓缓移出。">
			<img src="data:image/gif;base64," alt="">
		</div>
		<<run setTimeout(() => window.EdenLifeStory.startGeneration(State.variables.eden, State.variables.children, State.variables.eden.selectedChildId), 0)>>
		<p><<link [[暂且收好信件|Eden Contacts]]>><</link>></p>
	<</if>>
</div>

:: Eden Life Story Read
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">><<effects>>
<div class="eden-panel">
	<<set _edenChildId to $eden.selectedChildId>>
	<<set _edenRecord to _edenChildId ? $eden.children[_edenChildId] : undefined>>
	<<set _edenChild to ($children and _edenChildId) ? $children[_edenChildId] : undefined>>
	<<set _edenLifeStory to _edenRecord ? window.EdenLifeStory.ensureState(_edenRecord) : null>>
	<<set _edenStoryContent to _edenLifeStory?.content>>
	<<if !_edenRecord or !_edenChild or !_edenStoryContent>>
		<p class="red">这封来信还没有可以阅读的内容。</p>
		<<link [[返回通讯录|Eden Contacts]]>><</link>>
	<<else>>
		<<run window.EdenLifeStory.markRead(_edenRecord)>>
		<div class="eden-life-story-section">
			<p class="eden-life-story-text"><<= Util.escapeMarkup(_edenStoryContent.universityExperience)>></p>
		</div>
		<div class="eden-life-story-section">
			<p class="eden-life-story-text"><<= Util.escapeMarkup(_edenStoryContent.economicSituation)>></p>
		</div>
		<div class="eden-life-story-section">
			<p class="eden-life-story-text"><<= Util.escapeMarkup(_edenStoryContent.marriageSituation)>></p>
		</div>
		<div class="eden-life-story-section">
			<p class="eden-life-story-text"><<= Util.escapeMarkup(_edenStoryContent.dailyLife)>></p>
		</div>
		<div class="eden-life-story-section">
			<p class="eden-life-story-text"><<= Util.escapeMarkup(_edenStoryContent.attitudeToPc)>></p>
		</div>
		<<if _edenStoryContent.photoDescriptions?.length>>
			<div class="eden-life-story-section">
				<p><span class="gold">随信照片</span></p>
				<<for _edenPhoto range _edenStoryContent.photoDescriptions>>
					<p class="grey eden-life-story-text"><<= Util.escapeMarkup(_edenPhoto)>></p>
				<</for>>
			</div>
		<</if>>
		<br>
		<<if $eden.lifeStoryReadMode is "reread">>
			<<link [[继续|Eden Life Story Reread Ending]]>><</link>>
		<<else>>
			<<link [[继续|Eden Life Story Ending]]>><</link>>
		<</if>>
	<</if>>
</div>

:: Eden Life Story Ending
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">><<effects>>
<div class="eden-panel">
	<<set $eden.lifeStoryReadMode to null>>
	<p>你已经看完了很久，但仍然怔怔地举着它。</p>
	<p>放下信时，你发觉自己眼角有一滴温热的泪水。</p>
	<br>
	<<link [[收好来信，返回大厅|Eden Home]]>><</link>>
</div>

:: Eden Life Story Reread
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">><<effects>>
<div class="eden-panel">
	<<set _edenRecord to $eden.selectedChildId ? $eden.children[$eden.selectedChildId] : undefined>>
	<<if !_edenRecord or typeof window.EdenLifeStory isnot "object" or !window.EdenLifeStory.canRead(_edenRecord)>>
		<p class="red">这封来信还没有可以重读的内容。</p>
		<<link [[返回通讯录|Eden Contacts]]>><</link>>
	<<else>>
		<p>你拿起信，深吸一口气，翻开了信件。</p>
		<br>
		<<link [[继续阅读|Eden Life Story Read]]>><<set $eden.lifeStoryReadMode to "reread">><</link>>
	<</if>>
</div>

:: Eden Life Story Reread Ending
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">><<effects>>
<div class="eden-panel">
	<<set $eden.lifeStoryReadMode to null>>
	<p>你放下了信。哪怕再读一遍，你仍然感到触动。</p>
	<br>
	<<link [[收好来信，返回通讯录|Eden Contacts]]>><</link>>
</div>
