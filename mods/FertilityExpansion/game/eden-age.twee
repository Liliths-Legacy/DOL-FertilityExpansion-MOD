:: Eden Age Widgets [widget]
<<widget "edenNormalizeAgeSettings">>
<<if typeof window.EdenRuntime?.isReady is "function" and window.EdenRuntime.isReady()>><<silently>>
	<<if $options.eden is undefined or typeof $options.eden isnot "object" or Array.isArray($options.eden)>>
		<<set $options.eden to { maturityDays: 90, neverAutoAdult: false, resetAgeOnTransfer: false, allowHumanDescendants: false, lifeStoryPrompt: "", immediateLifeStory: false, allowSterilePregnancy: false, showHallHotspots: true, parentTitleSource: "parentage", enableNightVisits: true }>>
	<</if>>
	<<if typeof $options.eden.showHallHotspots isnot "boolean">><<set $options.eden.showHallHotspots to true>><</if>>
	<<run window.EdenAge.normalizeSettings($options.eden)>>
	<<set $eden.settings to clone($options.eden)>>
	<<if window.EdenSaveMigration?.ensureReady() isnot false>>
		<<run window.EdenAge.syncAll($eden, window.EdenChildData.collection())>>
	<</if>>
<</silently>><<else>>
	<div class="eden-panel red">生育拓展功能尚未加载完整，暂时无法应用成长设置，原有设置已保留。请重新启动游戏。</div>
<</if>><</widget>>

<<widget "edenAgeSettingsPanel">>
		<div class="settingsHeader">生育扩展·主选项</div>
		<div class="settingsToggleItemWide">
			<label>
				成年基准天数：
				<<numberbox "$options.eden.maturityDays" $options.eden.maturityDays>>
			</label>
			<<button "应用">>
				<<edenNormalizeAgeSettings>>
				<<replace "#eden-age-settings">><<edenAgeSettingsPanel>><</replace>>
			<</button>>
			<br>
			<small>默认90天，最低30天，不设上限。修改后所有孩子会按出生日期重新计算阶段。</small>
		</div>
		<div class="settingsToggleItemWide">
			<label><<checkbox "$options.eden.neverAutoAdult" false true autocheck>> 不会自动成年</label>
			<br>
			<small>开启后，孩子仍会依照上方天数成长到少年期，但不会自动进入成年。</small>
		</div>
		<div class="settingsToggleItemWide">
			<label><<checkbox "$options.eden.resetAgeOnTransfer" false true autocheck>> 将孩子带至伊甸园时重置年龄</label>
			<br>
			<small>开启后，之后接回的孩子会从入园当天按0天开始成长；不会追溯影响已经入住的孩子，也不会修改原版出生日期。</small>
		</div>
		<div class="settingsToggleItemWide">
			<label><<checkbox "$options.eden.allowHumanDescendants" false true autocheck>> 允许培养人类后代</label>
			<br>
			<small>开启后可以将培养对象扩展至非动物转化的纯人类。仅为功能性选项，不考虑年龄逻辑。</small>
		</div>
		<div class="settingsToggleItemWide">
			<label>孩子对你的称呼来源：
				<<listbox "$options.eden.parentTitleSource" autoselect>>
					<<option "根据受孕／授孕角色（默认）" "parentage">>
					<<option "根据自我的性别认知" "identity">>
					<<option "根据外表表现动态判断" "appearance">>
				<</listbox>>
			</label>
			<br>
			<small>分别依据你是否生下孩子、你在原版中的自我性别认知，或当前外表被判断为男性／女性来使用“爸爸”或“妈妈”。自我认知为“两者皆非”时沿用默认亲缘称呼。</small>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">种族成年修正：</span>
			鸟 ×0.75｜猫 ×0.9｜狐狸 ×1｜狼 ×1.1｜牛 ×1.25｜其他 ×1
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">阶段占比：</span>
			婴儿期 10%｜幼儿期 20%｜少儿期 30%｜少年期 40%
		</div>
		<</widget>>

<<widget "edenPregnancySettingsPanel">>
	<div class="settingsHeader">生育拓展·怀孕设置</div>
	<div class="settingsToggleItemWide">
		<label><<checkbox "$options.eden.allowSterilePregnancy" false true autocheck>> 不准绝育</label>
		<br>
		<small>开启后，Bailey、Leighton 与 Gwylan 可按原版生理与怀孕规则参与受孕或授孕；Gwylan 的裸手牵手和无遮挡接吻在奇幻怀孕模式下也可触发受孕，概率、周期、药物与怀孕开关仍按原版规则判断（旧版为童话模式）。这些角色没有完整的专属怀孕剧情，剧情可能不会回应怀孕状态。若关闭时角色已怀孕，模组会暂时保留该孕程的支持，防止存档数据被原版清除。</small>
	</div>
<</widget>>

<<widget "edenFacilitySettingsPanel">>
	<div class="settingsHeader">生育拓展·伊甸园设置</div>
	<div class="settingsToggleItemWide">
		<label><<checkbox "$options.eden.showHallHotspots" false true autocheck>> 显示伊甸园大厅可点击范围</label>
		<br>
		<small>关闭后仍可点击房间中的对应位置，只隐藏白色提示框。</small>
	</div>
	<div class="settingsToggleItemWide">
		<label><<checkbox "$options.eden.enableNightVisits" false true autocheck>> 开启伊甸园夜袭剧情</label>
		<br>
		<small>关闭后，在伊甸园睡觉时不会触发任何成年孩子的卧室来访；尚未播放的来访也会取消。</small>
	</div>
<</widget>>

	<<widget "edenSettings">>
		<<edenSetup>><<edenNormalizeAgeSettings>>
		<div id="eden-age-settings" class="solidBorderContainer settings-container">
			<<edenAgeSettingsPanel>>
		</div>
		<div id="eden-pregnancy-settings" class="solidBorderContainer settings-container">
			<<edenPregnancySettingsPanel>>
		</div>
	<div id="eden-facility-settings" class="solidBorderContainer settings-container">
		<<edenFacilitySettingsPanel>>
	</div>
	<div id="eden-llm-settings" class="solidBorderContainer settings-container"></div>
	<<run setTimeout(() => window.EdenLLM?.renderSettings?.(document.getElementById("eden-llm-settings")), 0)>>
	<div id="eden-chat-settings" class="solidBorderContainer settings-container"></div>
	<<run setTimeout(() => window.EdenChatUI?.renderSettings?.(document.getElementById("eden-chat-settings")), 0)>>
<</widget>>
