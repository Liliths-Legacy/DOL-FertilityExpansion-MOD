:: Eden Facility Widgets [widget]
<<widget "edenLocationIcon">><img class="icon" src="data:image/png;base64,"> <</widget>>
<<widget "edenResidentIds">><<silently>>
	<<set _edenResidentIds to []>>
	<<if $children and typeof $children is "object">>
		<<set _edenResidentIds to Object.keys($children).filter(id => $children[id].location === "eden_home")>>
	<</if>>
	<<set _edenResidentCount to _edenResidentIds.length>>
<</silently>><</widget>>

<<widget "edenMoveSelectedChildHome">><<silently>>
	<<set _edenTransferChildId to $eden.selectedChildId>>
	<<if $children?.[_edenTransferChildId] and $eden.children?.[_edenTransferChildId] and window.EdenAge.isHumanoid($eden.children[_edenTransferChildId], $children[_edenTransferChildId])>>
		<<set $children[_edenTransferChildId].location to "eden_home">>
		<<set $eden.children[_edenTransferChildId].status to "resident">>
		<<set $eden.children[_edenTransferChildId].transferSource to $eden.transferSource>>
		<<if typeof $options.eden is "object" and $options.eden.resetAgeOnTransfer and typeof window.EdenAge is "object">>
			<<run window.EdenAge.resetGrowthAge($eden.children[_edenTransferChildId])>>
		<</if>>
		<<if !Number.isFinite($eden.children[_edenTransferChildId].affection)>><<set $eden.children[_edenTransferChildId].affection to 40>><</if>>
		<<run delete $eden.childListReturn>>
		<<run delete $eden.transferSource>>
	<</if>>
<</silently>><</widget>>

<<widget "edenFarmlandLink">>
	<<edenSetup>>
	<<if $farm_stage isnot undefined>>
		<div class="eden-world-entry">
			<<if $eden.facility.owned>>
				<<edenLocationIcon>><<link [[前往伊甸园 (0:05)|Eden Home]]>><<set $eden.lifeStoryVisitHandled to false>><<pass 5>><</link>>
			<<else>>
				<<link [[查看待售房产|Eden Property]]>><</link>>
			<</if>>
		</div>
	<</if>>
<</widget>>

:: Eden Property
<<edenSetup>><<set $outside to 1>><<set $location to "farm">><<effects>>
<div class="eden-panel">
	<<if $farm_stage is undefined>>
		<p>你还不知道这处房产位于哪里。</p>
	<<elseif $eden.facility.owned>>
		<p>这座小屋已经属于你。你给它取名为“伊甸园”。</p>
		<<edenLocationIcon>><<link [[前往伊甸园|Eden Home]]>><<set $eden.lifeStoryVisitHandled to false>><</link>>
	<<else>>
		<p>Alex的农场附近有一座带围地的小屋正在出售。小屋带有卧室、浴室、玩具房、图书室和小花园，初始可以照看三名孩子。</p>
		<p>购房价格：<<printmoney 35000000>></p>
		<<if $money gte 35000000>>
			<<link [[购买伊甸园|Eden Home]]>>
				<<money -35000000 "edenProperty">>
				<<set $eden.facility.owned to true>>
				<<set $eden.facility.expanded to false>>
				<<set $eden.facility.capacity to 3>>
				<<set $eden.lifeStoryVisitHandled to false>>
			<</link>>
		<<else>>
			<span class="red">你的钱不够。</span>
		<</if>>
	<</if>>
	<br><br>
	<<link [[离开|Farmland]]>><</link>>
</div>

:: Eden Home
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">>
<<set _edenDueParentId to typeof window.EdenBreeding is "object" ? window.EdenBreeding.nextDue($eden) : null>>
<<if _edenDueParentId>>
	<<set $eden.breeding.activeBirthParentId to _edenDueParentId>><<goto "Eden Adult Birth">>
<<elseif !$eden.lifeStoryVisitHandled>>
	<<set _edenDueLetterChildId to typeof window.EdenLifeStory is "object" ? window.EdenLifeStory.nextDue($eden) : null>>
	<<if _edenDueLetterChildId>>
		<<set $eden.lifeStoryVisitHandled to true>>
		<<set $eden.selectedChildId to _edenDueLetterChildId>>
		<<run window.EdenLifeStory.markDiscovered($eden.children[_edenDueLetterChildId])>>
		<<goto "Eden Life Story Arrival">>
	<</if>>
<</if>>
<<effects>>
<div class="eden-panel">
	<<if !$eden.facility.owned>>
		<p class="red">你还没有买下这里。</p>
		<<farmicon>><<link [[返回农场道路|Farmland]]>><</link>>
	<<else>>
		<<edenResidentIds>>
		<p>这座小屋位于小镇外，紧邻Alex的农场。远离镇上的喧嚣后，周围显得格外安静。</p>
		<p>当前入住：<<= _edenResidentCount>> / <<= $eden.facility.capacity>></p>
		<<furnitureicon "catalogue">><<link [[室内陈设|Eden Decorations]]>><</link>>
		<br>
		<<if !$eden.facility.expanded>>
			<<icon "hammer-nails.png">><<link [[扩建小屋|Eden Expansion]]>><</link>>
			<br>
		<</if>>
		<br>
		<<bedroomicon>><<link [[前往卧室|Eden Safehouse Bedroom]]>><</link>>
		<br>
		<<bathroomicon>><<link [[前往浴室|Eden Safehouse Bathroom]]>><</link>>
		<br><br>
		<<icon "child-toys/crib.png">><<link [[前往育儿室|Eden Nursery]]>><</link>>
		<br>
		<<icon "email.png">><<link [[查看通讯录|Eden Contacts]]>><</link>>
		<br>
		<<schoolicon "library">><<link [[查看育儿手册|Eden Handbook]]>><</link>>
		<br><br>
		<<farmicon>><<link [[返回农场道路 (0:05)|Farmland]]>><<pass 5>><</link>>
	<</if>>
</div>

:: Eden Expansion
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">><<effects>>
<div class="eden-panel">
	<<if !$eden.facility.owned>>
		<p class="red">你还没有买下这里。</p>
	<<elseif $eden.facility.expanded>>
		<p>小屋已经完成扩建，目前可以照看六名孩子。</p>
	<<else>>
		<p>扩建新的卧室和生活空间后，伊甸园可以容纳六名孩子。</p>
		<p>扩建费用：<<printmoney 5000000>></p>
		<<if $money gte 5000000>>
			<<link [[支付扩建费用|Eden Home]]>>
				<<money -5000000 "edenExpansion">>
				<<set $eden.facility.expanded to true>>
				<<set $eden.facility.capacity to 6>>
			<</link>>
		<<else>>
			<span class="red">你的钱不够。</span>
		<</if>>
	<</if>>
	<br><br>
	<<link [[返回伊甸园|Eden Home]]>><</link>>
</div>

:: Eden Nursery
<<edenSetup>><<set $outside to 0>><<set $location to "eden_home">><<effects>>
<div class="eden-panel">
	<<if !$eden.facility.owned>>
		<p class="red">你还没有买下这里。</p>
	<<else>>
		<<if $storedChildrenToys is undefined>><<set $storedChildrenToys to {}>><</if>>
		<<if $storedChildrenToys["eden_home"] is undefined>><<set $storedChildrenToys["eden_home"] to []>><</if>>
		<<getChildrenIds `{location: "eden_home"}` "both">>
		<<if _childrenIds.length>>
			<p>你在育儿室里找到了自己的<<= _childrenIds.length > 1 ? "孩子们" : "孩子">>。</p>
			<<childViewerDisplay _childrenIds>>
		<<else>>
			<p>育儿室已经准备好了，但目前还没有孩子入住。</p>
		<</if>>
	<</if>>
	<br>
	<<link [[返回伊甸园|Eden Home]]>><</link>>
</div>

:: Eden Child Transfer
<<edenSetup>><<effects>>
<div class="eden-panel">
	<<set _edenChildId to $eden.selectedChildId>>
	<<set _edenChild to ($children and _edenChildId) ? $children[_edenChildId] : undefined>>
	<<set _edenRecord to _edenChildId ? $eden.children[_edenChildId] : undefined>>
	<<set _edenTransferSource to $eden.transferSource>>
	<<set _edenIsPcChild to _edenChild and (_edenChild.mother is "pc" or _edenChild.father is "pc")>>
	<<set _edenIsAdoptedHawk to _edenChild and _edenTransferSource is "tower" and _edenChild.type is "hawk" and _edenChild.adopted>>
	<<set _edenIsHumanoid to _edenRecord and _edenChild and window.EdenAge.isHumanoid(_edenRecord, _edenChild)>>
	<<edenResidentIds>>
	<<if !$eden.facility.owned>>
		<p class="red">你还没有能安置孩子的地方。</p>
	<<elseif !_edenChild or (!_edenIsPcChild and !_edenIsAdoptedHawk)>>
		<p class="red">你无法确认要带走的孩子。</p>
	<<elseif !_edenIsHumanoid>>
		<p>这个孩子保持着动物形态，暂时不适合带到伊甸园抚养。</p>
	<<elseif _edenChild.location isnot _edenTransferSource>>
		<p>这个孩子已经不在这里了。</p>
	<<elseif _edenTransferSource is "tower" and _edenChild.eggTimer isnot undefined>>
		<p>这枚蛋还没有孵化，现在还不能带去伊甸园。</p>
	<<elseif ["wolf_cave", "tower", "alex_cottage"].includes(_edenTransferSource)>>
		<<set _edenTransferIntroduced to $eden.facility.transferIntroduced[_edenTransferSource]>>
		<<if !_edenTransferIntroduced>>
			<<if _edenTransferSource is "wolf_cave">>
				<p>你抱起<<= Util.escapeMarkup(_edenChild.name || "孩子")>>，向守在幼崽身边的狼群说明了伊甸园的事。那是你在农场附近买下的房子，有干净的房间、充足的食物，也有能让孩子奔跑玩耍的地方。</p>
				<p>狼群低声骚动起来。几只成年狼挡在通道前，警惕地打量着你。黑狼从它们中间走出，绕着你和孩子慢慢走了一圈。</p>
				<p>你低下头，告诉它们，你会经常带孩子回来，这里依然是孩子的家。</p>
				<p>黑狼凝视了你很久，最后伸出鼻子蹭了蹭幼崽，向后退开。守在通道前的狼群也慢慢让出一条路。</p>
			<<elseif _edenTransferSource is "tower">>
				<p>你抱起<<= Util.escapeMarkup(_edenChild.name || "孩子")>>，向巨鹰说起了伊甸园。那是你在农场附近买下的房子，更宽敞，也更适合孩子长大。</p>
				<p>巨鹰立刻张开翅膀，挡在你和巢穴之间。鸟嗓里滚出不满的低鸣，羽毛也一根根竖了起来。</p>
				<p>你耐心地重复，伊甸园离农场不远，巨鹰随时都可以去看望孩子。你也不会让孩子忘记这座高塔和天空。</p>
				<p>巨鹰低头梳理着孩子的羽毛，迟迟不肯离开。过了很久，才终于收起翅膀，用额头轻轻碰了碰你。</p>
			<<else>>
				<<npc "Alex">><<person1>>
				<p>你找到Alex，告诉<<him>>，你在农场旁边买下了一栋房子，专门用来照顾和抚养孩子。</p>
				<p>Alex惊讶地看着你。“你买下了一栋房子？就在农场旁边？”</p>
				<p>你点点头，说那里有宽敞的房间、玩具房和花园。从农场走过去不需要多久，Alex随时都可以去看他们。</p>
				<p>“你还真的想好了。”Alex沉默了一会儿，看向育儿室。“要是真的这么近……好吧。这里永远有他们的位置。我也会过去看他们。”</p>
			<</if>>
			<<set $eden.facility.transferIntroduced[_edenTransferSource] to true>>
		<<elseif _edenTransferSource is "wolf_cave">>
			<p>你再次抱起<<= Util.escapeMarkup(_edenChild.name || "孩子")>>，向狼群示意。黑狼认出了你的意图，走近嗅了嗅孩子，随后带着狼群让开了通往洞外的路。</p>
		<<elseif _edenTransferSource is "tower">>
			<p>你抱起<<= Util.escapeMarkup(_edenChild.name || "孩子")>>。巨鹰靠近替孩子理了理羽毛，又轻轻碰了碰你的肩膀。虽然依依不舍，巨鹰没有阻拦你。</p>
		<<else>>
			<p>你告诉Alex，想让<<= Util.escapeMarkup(_edenChild.name || "孩子")>>搬去伊甸园。Alex点了点头，帮你收拾好孩子的东西，又叮嘱你有事随时来农场。</p>
		<</if>>
	<</if>>

	<<if ["wolf_cave", "tower", "alex_cottage"].includes(_edenTransferSource) and _edenChild and _edenChild.location is _edenTransferSource and _edenIsHumanoid and (_edenIsPcChild or _edenIsAdoptedHawk) and !(_edenTransferSource is "tower" and _edenChild.eggTimer isnot undefined)>>
		<<if _edenResidentCount gte $eden.facility.capacity>>
			<p class="red">伊甸园已经没有空位。</p>
		<<else>>
			<<link [[将孩子带至伊甸园|Eden Nursery]]>><<edenMoveSelectedChildHome>><</link>>
		<</if>>
	<</if>>
	<br><br>
	<<link [[返回|$eden.returnPassage]]>><<run delete $eden.transferSource>><</link>>
</div>

:: Eden Bailey Negotiation
<<edenSetup>><<effects>>
<div class="eden-panel">
	<<set _edenChildId to $eden.selectedChildId>>
	<<set _edenChild to ($children and _edenChildId) ? $children[_edenChildId] : undefined>>
	<<set _edenRecord to _edenChildId ? $eden.children[_edenChildId] : undefined>>
	<<edenResidentIds>>
	<<if !$eden.facility.owned>>
		<p class="red">你还没有能安置孩子的地方。</p>
	<<elseif !_edenChild or (_edenChild.mother isnot "pc" and _edenChild.father isnot "pc")>>
		<p class="red">贝利不知道你在说哪个孩子。</p>
	<<elseif !_edenRecord or !window.EdenAge.isHumanoid(_edenRecord, _edenChild)>>
		<p>这个孩子保持着动物形态，暂时不适合带到伊甸园抚养。</p>
	<<elseif _edenChild.location isnot "home">>
		<p>这个孩子已经不在孤儿院了。</p>
	<<else>>
		<<if !$eden.facility.baileyIntroduced>>
			<<set _edenOtherParentRole to "的另一位家长">>
			<<set _edenOtherParentName to "">>
			<<set _edenOtherParentGender to "">>
			<<if _edenChild.mother is "pc" and _edenChild.father isnot "pc">>
				<<set _edenOtherParentRole to "父亲">>
				<<set _edenOtherParentName to _edenChild.father>>
				<<set _edenOtherParentGender to C.npc[_edenOtherParentName]?.pronoun or $parentList?.fathers?.find(parent => parent.name === _edenOtherParentName)?.npc?.pronoun>>
			<<elseif _edenChild.father is "pc" and _edenChild.mother isnot "pc">>
				<<set _edenOtherParentRole to "母亲">>
				<<set _edenOtherParentName to _edenChild.mother>>
				<<set _edenOtherParentGender to C.npc[_edenOtherParentName]?.pronoun or $parentList?.mothers?.find(parent => parent.name === _edenOtherParentName)?.npc?.pronoun>>
			<</if>>
			<<set _edenOtherParentPronoun to _edenOtherParentGender is "m" ? "他" : _edenOtherParentGender is "f" ? "她" : _edenOtherParentRole is "父亲" ? "他" : _edenOtherParentRole is "母亲" ? "她" : "对方">>
			<<set _edenBaileyPronoun to C.npc.Bailey.pronoun is "m" ? "他" : "她">>
			<p>你抱着孩子，和贝利说出了孩子<<= _edenOtherParentRole>>想要<<= _edenOtherParentPronoun>>的抚养权的事。</p>
			<p>“有人想要和你这个小婊子的野种？”贝利盯着你，“你觉得我会相信吗？”</p>
			<p>你感到热血上涌。被贝利羞辱让你感到愤怒，但是你知道这本身就不是一个容易的事。</p>
			<p>“如果<<= _edenOtherParentPronoun>>想要，叫<<= _edenOtherParentPronoun>>自己来孤儿院和我谈。”</p>
			<p>你抬起头，硬着头皮声称对方不方便出面。你看到贝利的嘴角动了动，一声冷笑随之滚落你的耳边。</p>
			<p>“那就让这小崽子继续待在这。”<<= _edenBaileyPronoun>>说，“我不会把监护权交给一个我一无所知的人。”</p>
			<p><<= _edenBaileyPronoun>>戏谑的语调让你发寒，你不知道<<= _edenBaileyPronoun>>是否已经看出你在撒谎。但是你仍然将对话继续了下去。你告诉<<= _edenBaileyPronoun>>，如果孩子<<= _edenOtherParentRole>>不能如愿带走孩子，将会从镇外走法律程序。</p>
			<p>贝利没接话。<<= _edenBaileyPronoun>>沉默了，视线锁在你的脸上。你努力不让自己的肌肉颤抖。随后你听到<<= _edenBaileyPronoun>>的声音。</p>
			<p>“可以。但回去告诉<<= _edenOtherParentPronoun>>，<<= _edenOtherParentPronoun>>碰了我的财产，在我不知情的情况下把我的被监护人搞大了肚子。如果不想也吃一场官司的话……我要见到<<printmoney 10000000>>的歉意。”</p>
			<p>你睁大眼睛。这个价格超出了你的预期。</p>
			<p>你动了动喉咙。“你凭什么认为我会配合你……诉讼？”</p>
			<p>“我有一万种方式让你配合。现在，把孩子放下，然后出去，把钱给我带回来。”<<= _edenBaileyPronoun>>说。</p>
			<<set $eden.facility.baileyIntroduced to true>>
		<<else>>
			<p>贝利瞥了<<= Util.escapeMarkup(_edenChild.name || "孩子")>>一眼。</p>
			<p>“你知道规矩。”</p>
		<</if>>
		<<if _edenResidentCount gte $eden.facility.capacity>>
			<p class="red">伊甸园已经没有空位。</p>
		<<elseif $money lt 10000000>>
			<p class="red">你拿不出贝利要求的<<printmoney 10000000>>。</p>
		<<else>>
			<<link [[向贝利支付 £100,000|Eden Nursery]]>>
				<<money -10000000 "edenChildTransfer">>
					<<set $children[$eden.selectedChildId].location to "eden_home">>
					<<set $eden.children[$eden.selectedChildId].status to "resident">>
					<<set $eden.children[$eden.selectedChildId].transferPaid to true>>
					<<run delete $eden.childListReturn>>
				<<if typeof $options.eden is "object" and $options.eden.resetAgeOnTransfer and typeof window.EdenAge is "object">>
					<<run window.EdenAge.resetGrowthAge($eden.children[$eden.selectedChildId])>>
				<</if>>
					<<if !Number.isFinite($eden.children[$eden.selectedChildId].affection)>><<set $eden.children[$eden.selectedChildId].affection to 40>><</if>>
			<</link>>
		<</if>>
	<</if>>
	<br><br>
	<<link [[离开|$eden.returnPassage]]>><</link>>
</div>
